{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@resili/core": ["packages/core/src/index.ts"]
    }
  },
  "include": [
    "eslint.config.js",
    "vitest.config.ts",
    "tsup.config.ts",
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.test.ts",
    "packages/*/tsup.config.ts",
    "*.config.ts"
  ],
  "exclude": ["node_modules", "**/dist/**", "**/coverage/**", "**/temp/**", "docs/api/**"]
}
