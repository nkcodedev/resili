{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.test.ts",
    "packages/*/tsup.config.ts",
    "eslint.config.js",
    "vitest.config.ts",
    "typedoc.config.ts"
  ],
  "exclude": ["node_modules", "**/dist/**", "**/coverage/**", "**/temp/**", "docs/api/**"]
}
