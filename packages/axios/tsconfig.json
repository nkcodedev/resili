{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",
    "paths": {}
  },
  "files": ["src/index.ts"],
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "coverage", "temp", "**/*.test.ts", "**/*.spec.ts"]
}
