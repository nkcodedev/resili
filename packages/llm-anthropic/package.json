{
  "name": "@resili/llm-anthropic",
  "version": "0.1.0-beta.1",
  "description": "Anthropic Messages adapter for the Resili LLM resilience foundation.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist tsbuild coverage temp",
    "dev": "tsup --watch",
    "typecheck": "tsc -b --pretty false",
    "api:extract": "api-extractor run --local",
    "api:check": "api-extractor run --verbose"
  },
  "dependencies": {
    "@resili/core": "workspace:*",
    "@resili/llm": "workspace:*"
  },
  "peerDependencies": {
    "@anthropic-ai/sdk": ">=0.20.0"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/sdk": {
      "optional": true
    }
  },
  "devDependencies": {},
  "author": {
    "name": "Nitin Kaushal",
    "email": "nkcodedev.chd@gmail.com",
    "url": "https://github.com/nkcodedev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nkcodedev/resili.git"
  },
  "bugs": {
    "url": "https://github.com/nkcodedev/resili/issues"
  },
  "homepage": "https://resili.nkcode.dev/",
  "keywords": [
    "resili",
    "llm",
    "anthropic",
    "claude",
    "nodejs",
    "typescript",
    "resilience",
    "messages-api",
    "fault-tolerance"
  ]
}
