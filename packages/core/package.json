{
  "name": "@resili/core",
  "version": "0.1.0-alpha.1",
  "description": "Core Resili resilience toolkit package.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist coverage temp",
    "dev": "tsup --watch",
    "typecheck": "tsc -b --pretty false",
    "api:extract": "api-extractor run --local",
    "api:check": "api-extractor run --local --verbose",
    "pack:check": "npm pack --pack-destination temp --ignore-scripts"
  },
  "dependencies": {},
  "devDependencies": {},
  "author": "Nitin Kaushal <nkcodedev.chd@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nkcodedev/resili.git"
  },
  "bugs": {
    "url": "https://github.com/nkcodedev/resili/issues"
  },
  "homepage": "https://github.com/nkcodedev/resili",
  "keywords": [
    "resili",
    "resilience",
    "typescript",
    "nodejs",
    "retry",
    "timeout",
    "circuit-breaker",
    "bulkhead",
    "rate-limiter",
    "fallback",
    "resilience-patterns",
    "distributed-systems",
    "microservices",
    "fault-tolerance",
    "reliability",
    "cloud",
    "serverless",
    "middleware",
    "plugin",
    "observability"
  ]
}
