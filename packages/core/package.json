{
  "name": "@resili/core",
  "version": "0.2.0-alpha.3",
  "description": "TypeScript-first resilience toolkit for production Node.js applications.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist tsbuild coverage temp",
    "dev": "tsup --watch",
    "typecheck": "tsc -b --pretty false",
    "api:extract": "api-extractor run --local",
    "api:check": "api-extractor run --local --verbose",
    "pack:check": "npm pack --pack-destination temp --ignore-scripts"
  },
  "dependencies": {},
  "devDependencies": {},
  "author": {
    "name": "Nitin Kaushal",
    "email": "nkcodedev.chd@gmail.com",
    "url": "https://github.com/nkcodedev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nkcodedev/resili.git"
  },
  "bugs": {
    "url": "https://github.com/nkcodedev/resili/issues"
  },
  "homepage": "https://resili.nkcode.dev/",
  "keywords": [
    "resili",
    "nodejs",
    "typescript",
    "resilience",
    "retry",
    "timeout",
    "circuit-breaker",
    "bulkhead",
    "rate-limiter",
    "fallback",
    "cache",
    "request-deduplication",
    "hedged-requests",
    "observability",
    "middleware",
    "fault-tolerance",
    "plugin"
  ]
}
