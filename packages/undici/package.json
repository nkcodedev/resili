{
  "name": "@resili/undici",
  "version": "0.0.0",
  "description": "Undici-compatible adapter for Resili.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist coverage temp",
    "dev": "tsup --watch",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@resili/core": "workspace:*"
  },
  "devDependencies": {}
}
